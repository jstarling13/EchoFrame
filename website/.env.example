# Copy to .env.local for development. Never commit real values (.env* is gitignored except this file).

NEXT_PUBLIC_SITE_URL=http://localhost:3000
LEAD_NOTIFICATION_EMAIL=
PRIVACY_CONTACT_EMAIL=

# CRM lead routing (generic webhook; point at whichever CRM the owner selects)
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# Stripe (test mode keys during implementation; live keys only after owner approval)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_O1=
STRIPE_PRICE_O2=
STRIPE_PRICE_O3=
STRIPE_PRICE_O4=
STRIPE_PRICE_O5_MONTHLY=

# Transactional email (Resend REST API by default; swap lib/email.ts if a different vendor is chosen)
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=

# Observability / analytics (privacy-aware; leave unset to disable)
ANALYTICS_ID=
ERROR_MONITOR_DSN=

# Rate limiting store (Upstash Redis REST-compatible). Leave unset to fall back
# to an in-memory limiter, which is NOT safe across multiple serverless instances.
RATE_LIMIT_STORE_URL=
RATE_LIMIT_STORE_TOKEN=

# Contact form spam protection
CONTACT_FORM_HONEYPOT_FIELD=company_website
