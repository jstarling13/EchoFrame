# ── EchoFrame backend — required environment variables ────────────────────────
# Copy this file to .env and fill in real values. Never commit .env to git.

# Stripe
STRIPE_SECRET_KEY=sk_live_...
PRICE_ID_MONTHLY_CLARITY_REPORT=price_...
PRICE_ID_BUSINESS_AUDIT=price_...
PRICE_ID_COMPETITOR_REPORT=price_...

# CORS origin(s) — comma-separated if multiple
CLIENT_URL=https://yourdomain.com

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# Resend (email delivery)
RESEND_API_KEY=re_...
# Client-facing From address (must be on a Resend-verified domain). Defaults to
# "EchoFrame <jacob.starling@echoframe.net>" if unset.
EMAIL_FROM=EchoFrame <jacob.starling@echoframe.net>
# Where "client hasn't uploaded" alerts are sent.
ALERT_EMAIL=jacob.starling@echoframe.net

# ── Recurring monthly fulfilment loop (renewals) ──────────────────────────────
# HMAC secret for signing upload links. Generate once: `openssl rand -hex 32`.
SIGNING_SECRET=
# Public base URL of THIS backend (where upload links point). Use your subdomain
# once the CNAME is live, or the raw *.vercel.app URL in the meantime.
PUBLIC_BASE_URL=https://app.echoframe.net
# Days after billing before the reminder + owner alert fire (default 4).
REMINDER_AFTER_DAYS=4

# ── Durable store (Upstash Redis via Vercel Marketplace) ──────────────────────
# Auto-injected when you add the Upstash integration. Without these the app uses
# a non-durable in-memory fallback (fine for local dev, NOT for production).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Vercel serverless ─────────────────────────────────────────────────────────
# Secret shared with the reminder Cron (Vercel sends it as a Bearer token).
CRON_SECRET=
# Writable paths on serverless (set automatically by api/index.py; override here
# only for local testing if desired).
# ECHOFRAME_UPLOADS_DIR=/tmp/echoframe/uploads
# ECHOFRAME_REPORTS_DIR=/tmp/echoframe/reports

# Optional
PORT=4242
