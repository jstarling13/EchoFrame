<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>EchoFrame — Bay Coach · {{ biz_name }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
<style>
  :root {
    --navy:#012A4A; --navy-2:#013a66; --amber:#C8972A; --green:#059669;
    --red:#DC2626; --ink:#1f2937; --muted:#6b7280; --line:#e5e7eb; --slate:#f1f5f9;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { background:#525659; font-family:'Inter',-apple-system,BlinkMacSystemFont,sans-serif; color:var(--ink); -webkit-font-smoothing:antialiased; }
  .page { width:8.5in; min-height:11in; margin:24px auto; background:#fff; box-shadow:0 6px 30px rgba(0,0,0,.35); display:flex; flex-direction:column; }
  .body { padding:16px 40px 0; flex:1; }
  .header { background:var(--navy); color:#fff; padding:14px 40px; display:flex; justify-content:space-between; align-items:center; border-bottom:3px solid var(--amber); }
  .header .biz { font-size:21px; font-weight:800; letter-spacing:-.2px; }
  .header .sub { font-size:9.5px; color:#9CA3AF; margin-top:3px; letter-spacing:.2px; }
  .brand { text-align:right; }
  .brand .pre { font-size:7px; font-weight:700; letter-spacing:1.5px; color:#fff; }
  .brand .mark { font-size:27px; font-weight:800; color:var(--amber); line-height:1; margin:1px 0; }
  .brand .tag { font-size:8px; font-style:italic; color:#cbd5e1; }
  .sample-banner { background:#FEF3C7; border:1px solid var(--amber); border-radius:6px; padding:6px 12px; margin-top:9px; font-size:9.5px; color:#7c5e10; display:flex; align-items:center; gap:8px; }
  .sample-banner b { color:#5c4708; }
  .chip { background:var(--amber); color:#fff; font-weight:700; font-size:8px; letter-spacing:1px; padding:2px 7px; border-radius:4px; white-space:nowrap; }
  .sec { display:flex; align-items:center; gap:8px; margin:11px 0 6px; }
  .sec .bar { width:4px; height:15px; background:var(--amber); border-radius:2px; }
  .sec h2 { font-size:11px; font-weight:700; color:var(--navy); text-transform:uppercase; letter-spacing:.8px; }
  .sec .hint { font-size:9px; color:var(--muted); font-weight:500; margin-left:auto; }
  .kpis { display:grid; grid-template-columns:repeat(3,1fr); gap:12px; margin-top:10px; }
  .kpi { background:var(--slate); border-radius:8px; padding:10px 15px; border-top:3px solid var(--amber); }
  .kpi .label { font-size:8.5px; font-weight:700; color:var(--navy); text-transform:uppercase; letter-spacing:.6px; }
  .kpi .value { font-size:22px; font-weight:800; color:var(--navy); margin:4px 0 2px; letter-spacing:-.5px; }
  .kpi .delta { font-size:9px; font-weight:600; }
  .kpi .delta.up { color:var(--green); } .kpi .delta.down { color:var(--red); } .kpi .delta.flat { color:var(--muted); }
  .vehcard { border:1px solid var(--line); border-radius:8px; margin-top:10px; overflow:hidden; }
  .vehcard .vhead { background:var(--slate); padding:9px 15px; display:flex; justify-content:space-between; align-items:flex-start; border-bottom:1px solid var(--line); }
  .vehcard .vname { font-size:13px; font-weight:800; color:var(--navy); letter-spacing:-.2px; }
  .vehcard .vmeta { font-size:8.5px; color:var(--muted); margin-top:2px; }
  .vehcard .vmile { text-align:right; }
  .vehcard .vmile .n { font-size:18px; font-weight:800; color:var(--navy); line-height:1; }
  .vehcard .vmile .l { font-size:7.5px; font-weight:700; color:var(--muted); text-transform:uppercase; letter-spacing:.6px; }
  .vbody { display:grid; grid-template-columns:1fr 1fr; }
  .vcol { padding:9px 15px; }
  .vcol + .vcol { border-left:1px solid var(--line); }
  .vcol .ttl { font-size:8px; font-weight:700; color:var(--navy); text-transform:uppercase; letter-spacing:.6px; margin-bottom:7px; }
  .hist { list-style:none; }
  .hist li { font-size:9px; color:#374151; padding:2px 0; border-bottom:1px dotted var(--line); display:flex; justify-content:space-between; gap:10px; }
  .hist li:last-child { border-bottom:0; }
  .hist li .d { color:var(--muted); white-space:nowrap; font-variant-numeric:tabular-nums; }
  .vstat { font-size:9px; color:#374151; line-height:1.5; }
  .vstat b { color:var(--ink); }
  table { width:100%; border-collapse:collapse; }
  thead th { background:var(--navy); color:#fff; font-size:8px; font-weight:700; text-transform:uppercase; letter-spacing:.5px; text-align:left; padding:7px 9px; }
  thead th.r { text-align:right; }
  tbody td { padding:5px 9px; font-size:9.5px; vertical-align:top; border-bottom:1px solid var(--line); }
  tbody tr:nth-child(even) { background:#fafbfc; }
  tbody tr.top td { background:#FEF3C7; }
  tbody tr.top td:first-child { box-shadow:inset 3px 0 0 var(--amber); }
  td.r { text-align:right; font-variant-numeric:tabular-nums; white-space:nowrap; }
  .svc { font-weight:700; color:var(--navy); }
  .why { color:var(--muted); font-size:8.5px; display:block; margin-top:2px; line-height:1.4; }
  .pill { display:inline-block; font-size:8.5px; font-weight:700; padding:2px 7px; border-radius:4px; white-space:nowrap; }
  .pill.due { background:#FDECEC; color:var(--red); } .pill.soon { background:#FEF3C7; color:#946200; } .pill.ok { background:#E7F6EF; color:var(--green); }
  tfoot td { padding:7px 9px; font-size:9.5px; font-weight:800; color:var(--navy); border-top:2px solid var(--navy); }
  tfoot td.r { text-align:right; font-variant-numeric:tabular-nums; }
  .card { border:1px solid var(--line); border-radius:8px; padding:10px 15px; margin-top:7px; }
  .card .ttl { font-size:9px; font-weight:700; color:var(--navy); text-transform:uppercase; letter-spacing:.6px; margin-bottom:6px; }
  .card p { font-size:9px; line-height:1.5; color:#374151; }
  .card .src { font-size:8px; color:var(--muted); margin-top:7px; }
  .card b { color:var(--ink); font-weight:600; }
  .onething { background:var(--navy); color:#fff; border-radius:10px; padding:13px 20px; margin:9px 0 4px; display:flex; gap:16px; align-items:center; }
  .onething .badge { background:var(--amber); color:var(--navy); font-weight:800; font-size:8px; letter-spacing:1px; padding:4px 9px; border-radius:5px; text-transform:uppercase; white-space:nowrap; align-self:flex-start; }
  .onething h3 { font-size:13px; font-weight:700; margin-bottom:4px; color:#fff; }
  .onething p { font-size:9.5px; line-height:1.5; color:#cbd5e1; }
  .onething .dollar { color:var(--amber); font-weight:800; }
  .footer { margin-top:6px; border-top:1px solid var(--line); padding:9px 40px; display:flex; justify-content:space-between; align-items:center; font-size:8px; color:var(--muted); letter-spacing:.3px; }
  .footer .ef { font-weight:800; color:var(--navy); }
  @media print { html,body{background:#fff;} .page{margin:0;box-shadow:none;width:auto;min-height:auto;} }
</style>
</head>
<body>
<div class="page">
  <div class="header">
    <div>
      <div class="biz">{{ biz_name }}</div>
      <div class="sub">{{ product_name }} · {{ product_tagline }} · {{ month }}{% if location %} · {{ location }}{% endif %}</div>
    </div>
    <div class="brand">
      <div class="pre">POWERED BY</div><div class="mark">EchoFrame</div>
      <div class="tag">Business intelligence, not accounting.</div>
    </div>
  </div>
  <div class="body">
    {% if is_sample %}
    <div class="sample-banner">
      <span class="chip">REDACTED SAMPLE</span>
      <span><b>This is an anonymized demonstration report.</b> Shop name, customer vehicle, mileage, and dollar amounts are fictional and do not represent a real client.</span>
    </div>
    {% endif %}

    <div class="sec"><span class="bar"></span><h2>Shop Performance at a Glance</h2><span class="hint">{{ glance_hint }}</span></div>
    <div class="kpis">
      {% for k in kpis %}
      <div class="kpi">
        <div class="label">{{ k.label }}</div>
        <div class="value">{{ k.value }}</div>
        <div class="delta {{ k.delta_class }}">{{ k.delta_text | safe }}</div>
      </div>
      {% endfor %}
    </div>

    <div class="sec"><span class="bar"></span><h2>Vehicle Write-Up Sheet</h2><span class="hint">{{ ro_hint }}</span></div>
    <div class="vehcard">
      <div class="vhead">
        <div>
          <div class="vname">{{ vehicle.name }}</div>
          <div class="vmeta">{{ vehicle.meta }}</div>
        </div>
        <div class="vmile">
          <div class="n">{{ vehicle.odometer }}</div>
          <div class="l">odometer (mi)</div>
        </div>
      </div>
      <div class="vbody">
        <div class="vcol">
          <div class="ttl">Service History on File</div>
          <ul class="hist">
            {% for h in history %}<li><span>{{ h.desc }}</span><span class="d">{{ h.when }}</span></li>{% endfor %}
          </ul>
        </div>
        <div class="vcol">
          <div class="ttl">What Bay Coach Reads From This</div>
          <p class="vstat">{{ vstat | safe }}</p>
        </div>
      </div>
    </div>

    <div class="sec"><span class="bar"></span><h2>Recommended Services — With Reasons</h2><span class="hint">matched to manufacturer interval &amp; this vehicle's history</span></div>
    <table>
      <thead><tr>
        <th>Service &amp; why now</th><th class="r" style="width:74px">Interval</th>
        <th style="width:78px">Status</th><th class="r" style="width:70px">Price</th>
      </tr></thead>
      <tbody>
        {% for s in services %}
        <tr{% if s.top %} class="top"{% endif %}>
          <td><span class="svc">{{ s.service }}</span><span class="why"><b>Why now:</b> {{ s.why }}</span></td>
          <td class="r">{{ s.interval }}</td>
          <td><span class="pill {{ s.pill_class }}">{{ s.status }}</span></td>
          <td class="r">{{ s.price }}</td>
        </tr>
        {% endfor %}
      </tbody>
      <tfoot><tr>
        <td>Total recommended this write-up</td><td class="r"></td><td></td><td class="r">{{ total }}</td>
      </tr></tfoot>
    </table>

    <div class="card">
      <div class="ttl">How Bay Coach Built This</div>
      <p>{{ method_note | safe }}</p>
      <p class="src">{{ source_line }}</p>
    </div>

    <div class="onething">
      <span class="badge">The One Thing</span>
      <div><h3>{{ one_thing.title }}</h3><p>{{ one_thing.body | safe }}</p></div>
    </div>
  </div>
  <div class="footer">
    <span><span class="ef">EchoFrame</span> &nbsp;·&nbsp; {{ product_name }}</span>
    <span>Page 1 of 1 · Confidential</span>
  </div>
</div>
</body>
</html>
