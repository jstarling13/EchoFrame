<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>EchoFrame — Drive Pay · {{ biz_name }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
<style>
  :root {
    --navy:#012A4A; --navy-2:#013a66; --amber:#C8972A; --green:#059669;
    --red:#DC2626; --ink:#1f2937; --muted:#6b7280; --line:#e5e7eb; --slate:#f1f5f9;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { background:#525659; font-family:'Inter',-apple-system,BlinkMacSystemFont,sans-serif; color:var(--ink); -webkit-font-smoothing:antialiased; }
  .page { width:8.5in; min-height:11in; margin:24px auto; background:#fff; box-shadow:0 6px 30px rgba(0,0,0,.35); display:flex; flex-direction:column; }
  .body { padding:22px 40px 0; flex:1; }
  .header { background:var(--navy); color:#fff; padding:20px 40px; display:flex; justify-content:space-between; align-items:center; border-bottom:3px solid var(--amber); }
  .header .biz { font-size:21px; font-weight:800; letter-spacing:-.2px; }
  .header .sub { font-size:9.5px; color:#9CA3AF; margin-top:3px; letter-spacing:.2px; }
  .brand { text-align:right; }
  .brand .pre { font-size:7px; font-weight:700; letter-spacing:1.5px; color:#fff; }
  .brand .mark { font-size:27px; font-weight:800; color:var(--amber); line-height:1; margin:1px 0; }
  .brand .tag { font-size:8px; font-style:italic; color:#cbd5e1; }
  .sample-banner { background:#FEF3C7; border:1px solid var(--amber); border-radius:6px; padding:7px 12px; margin-top:18px; font-size:9.5px; color:#7c5e10; display:flex; align-items:center; gap:8px; }
  .sample-banner b { color:#5c4708; }
  .chip { background:var(--amber); color:#fff; font-weight:700; font-size:8px; letter-spacing:1px; padding:2px 7px; border-radius:4px; white-space:nowrap; }
  .sec { display:flex; align-items:center; gap:8px; margin:20px 0 9px; }
  .sec .bar { width:4px; height:15px; background:var(--amber); border-radius:2px; }
  .sec h2 { font-size:11px; font-weight:700; color:var(--navy); text-transform:uppercase; letter-spacing:.8px; }
  .sec .hint { font-size:9px; color:var(--muted); font-weight:500; margin-left:auto; }
  .kpis { display:grid; grid-template-columns:repeat(4,1fr); gap:10px; margin-top:14px; }
  .kpi { background:var(--slate); border-radius:8px; padding:13px 14px; border-top:3px solid var(--amber); }
  .kpi .label { font-size:8px; font-weight:700; color:var(--navy); text-transform:uppercase; letter-spacing:.5px; }
  .kpi .value { font-size:24px; font-weight:800; color:var(--navy); margin:5px 0 2px; letter-spacing:-.5px; }
  .kpi .value small { font-size:11px; font-weight:700; color:var(--muted); letter-spacing:0; }
  .kpi .delta { font-size:8.5px; font-weight:600; line-height:1.35; }
  .kpi .delta.up { color:var(--green); } .kpi .delta.down { color:var(--red); } .kpi .delta.flat { color:var(--muted); }
  .thread { background:#f6f7f9; border:1px solid var(--line); border-radius:12px; padding:13px 13px 15px; margin-top:14px; }
  .thread .meta { font-size:8px; color:var(--muted); text-align:center; text-transform:uppercase; letter-spacing:.6px; font-weight:700; margin-bottom:10px; }
  .sysnote { text-align:center; font-size:8px; color:var(--navy); font-weight:700; background:#e8eef4; border-radius:5px; padding:4px 8px; margin:0 auto 10px; display:inline-block; }
  .syswrap { text-align:center; }
  .bubble { max-width:80%; padding:8px 11px; border-radius:13px; margin-bottom:8px; position:relative; }
  .bubble p { font-size:9.5px; line-height:1.4; }
  .bubble .t { font-size:7.5px; margin-top:4px; opacity:.8; }
  .bubble.out { background:var(--navy); color:#fff; margin-left:auto; border-bottom-right-radius:4px; }
  .bubble.out .who { font-size:7px; font-weight:700; letter-spacing:.5px; color:var(--amber); text-transform:uppercase; margin-bottom:2px; }
  .bubble.out .t { color:#cbd5e1; text-align:right; }
  .bubble.in { background:#fff; color:var(--ink); margin-right:auto; border:1px solid var(--line); border-bottom-left-radius:4px; }
  .bubble.in .who { font-size:7px; font-weight:700; letter-spacing:.5px; color:var(--muted); text-transform:uppercase; margin-bottom:2px; }
  .bubble.in .t { color:var(--muted); }
  .auto-tag { display:inline-block; font-size:6.5px; font-weight:700; letter-spacing:.4px; background:var(--amber); color:#fff; padding:1px 5px; border-radius:3px; margin-left:5px; vertical-align:middle; }
  table { width:100%; border-collapse:collapse; }
  thead th { background:var(--navy); color:#fff; font-size:7.5px; font-weight:700; text-transform:uppercase; letter-spacing:.4px; text-align:left; padding:7px 8px; }
  thead th.r { text-align:right; }
  tbody td { padding:7px 8px; font-size:9px; vertical-align:middle; border-bottom:1px solid var(--line); }
  tbody tr:nth-child(even) { background:#fafbfc; }
  tbody tr.win td:first-child { box-shadow:inset 3px 0 0 var(--green); }
  td.r { text-align:right; font-variant-numeric:tabular-nums; white-space:nowrap; }
  .time { font-weight:700; color:var(--navy); white-space:nowrap; }
  .veh { color:var(--ink); }
  .veh small { display:block; color:var(--muted); font-size:8px; }
  .resp { color:var(--muted); font-style:italic; }
  .pill { display:inline-block; font-size:8px; font-weight:700; padding:2px 7px; border-radius:4px; white-space:nowrap; }
  .pill.won { background:#E7F6EF; color:var(--green); } .pill.lost { background:#FDECEC; color:var(--red); } .pill.pend { background:#FEF3C7; color:#7c5e10; }
  .onething { background:var(--navy); color:#fff; border-radius:10px; padding:16px 20px; margin:22px 0 4px; display:flex; gap:16px; align-items:center; }
  .onething .badge { background:var(--amber); color:var(--navy); font-weight:800; font-size:8px; letter-spacing:1px; padding:4px 9px; border-radius:5px; text-transform:uppercase; white-space:nowrap; align-self:flex-start; }
  .onething h3 { font-size:13px; font-weight:700; margin-bottom:4px; color:#fff; }
  .onething p { font-size:9.5px; line-height:1.5; color:#cbd5e1; }
  .onething .dollar { color:var(--amber); font-weight:800; }
  .footer { margin-top:18px; border-top:1px solid var(--line); padding:11px 40px; display:flex; justify-content:space-between; align-items:center; font-size:8px; color:var(--muted); letter-spacing:.3px; }
  .footer .ef { font-weight:800; color:var(--navy); }
  @media print { html,body{background:#fff;} .page{margin:0;box-shadow:none;width:auto;min-height:auto;} }
</style>
</head>
<body>
<div class="page">
  <div class="header">
    <div>
      <div class="biz">{{ biz_name }}</div>
      <div class="sub">{{ product_name }} · {{ product_tagline }} · {{ month }}{% if location %} · {{ location }}{% endif %}</div>
    </div>
    <div class="brand">
      <div class="pre">POWERED BY</div><div class="mark">EchoFrame</div>
      <div class="tag">Business intelligence, not accounting.</div>
    </div>
  </div>
  <div class="body">
    {% if is_sample %}
    <div class="sample-banner">
      <span class="chip">REDACTED SAMPLE</span>
      <span><b>This is an anonymized demonstration report.</b> Business name, customers, and dollar figures are fictional and do not represent a real client. Card and phone details are masked.</span>
    </div>
    {% endif %}

    <div class="sec"><span class="bar"></span><h2>This Month at a Glance</h2><span class="hint">a pay link fires the moment a repair order closes</span></div>
    <div class="kpis">
      {% for k in kpis %}
      <div class="kpi">
        <div class="label">{{ k.label }}</div>
        <div class="value">{{ k.value }}{% if k.unit %}<small> {{ k.unit }}</small>{% endif %}</div>
        <div class="delta {{ k.delta_class }}">{{ k.delta_text | safe }}</div>
      </div>
      {% endfor %}
    </div>

    <div class="sec"><span class="bar"></span><h2>What the Customer Sees</h2><span class="hint">actual text-to-pay sequence · sample thread</span></div>
    <div class="thread">
      <div class="meta">{{ thread.meta }}</div>
      {% for it in thread.events %}
        {% if it.kind == 'sysnote' %}
        <div class="syswrap"><div class="sysnote"{% if it.tone == 'paid' %} style="background:#E7F6EF;color:#059669;"{% endif %}>{{ it.text }}</div></div>
        {% else %}
        <div class="bubble {{ it.dir }}">
          <div class="who">{{ it.who }}{% if it.auto %}<span class="auto-tag">{{ it.auto }}</span>{% endif %}</div>
          <p>{{ it.text }}</p>
          <div class="t">{{ it.time }}</div>
        </div>
        {% endif %}
      {% endfor %}
    </div>

    <div class="sec"><span class="bar"></span><h2>Pickup Payment Log</h2><span class="hint">{{ log_footnote }}</span></div>
    <table>
      <thead><tr>
        <th style="width:92px">RO Closed</th><th>Customer &amp; Vehicle</th>
        <th class="r" style="width:74px">Invoice</th><th style="width:96px">Pay Link</th>
        <th class="r" style="width:120px">Outcome</th>
      </tr></thead>
      <tbody>
        {% for r in log %}
        <tr{% if r.win %} class="win"{% endif %}>
          <td class="time">{{ r.time }}</td>
          <td class="veh">{{ r.customer }}{% if r.vehicle %} <small>{{ r.vehicle }}</small>{% endif %}</td>
          <td class="r">{{ r.invoice }}</td>
          <td class="resp">{{ r.paylink }}</td>
          <td class="r"><span class="pill {{ r.pill_class }}">{{ r.outcome }}</span></td>
        </tr>
        {% endfor %}
      </tbody>
    </table>

    <div class="onething">
      <span class="badge">The One Thing</span>
      <div><h3>{{ one_thing.title }}</h3><p>{{ one_thing.body | safe }}</p></div>
    </div>
  </div>
  <div class="footer">
    <span><span class="ef">EchoFrame</span> &nbsp;·&nbsp; {{ product_name }}</span>
    <span>Page 1 of 1 · Confidential</span>
  </div>
</div>
</body>
</html>
