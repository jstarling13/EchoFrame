<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>EchoFrame — Auto Ledger · {{ biz_name }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
<style>
  :root {
    --navy:   #012A4A;
    --navy-2: #013a66;
    --amber:  #C8972A;
    --green:  #059669;
    --red:    #DC2626;
    --ink:    #1f2937;
    --muted:  #6b7280;
    --line:   #e5e7eb;
    --slate:  #f1f5f9;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body {
    background: #525659;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    color: var(--ink);
    -webkit-font-smoothing: antialiased;
  }
  .page {
    width: 8.5in;
    min-height: 11in;
    margin: 24px auto;
    background: #fff;
    box-shadow: 0 6px 30px rgba(0,0,0,.35);
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .body { padding: 22px 40px 0; flex: 1; }

  /* ── Header band ───────────────────────────── */
  .header {
    background: var(--navy);
    color: #fff;
    padding: 20px 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 3px solid var(--amber);
  }
  .header .biz { font-size: 21px; font-weight: 800; letter-spacing: -.2px; }
  .header .sub { font-size: 9.5px; color: #9CA3AF; margin-top: 3px; letter-spacing: .2px; }
  .brand { text-align: right; }
  .brand .pre { font-size: 7px; font-weight: 700; letter-spacing: 1.5px; color: #fff; }
  .brand .mark { font-size: 27px; font-weight: 800; color: var(--amber); line-height: 1; margin: 1px 0; }
  .brand .tag { font-size: 8px; font-style: italic; color: #cbd5e1; }
  .tierchip {
    display: inline-block; background: var(--amber); color: var(--navy);
    font-size: 7px; font-weight: 800; letter-spacing: 1px; padding: 2px 7px;
    border-radius: 4px; text-transform: uppercase; margin-top: 5px;
  }

  /* ── Sample banner ─────────────────────────── */
  .sample-banner {
    background: #FEF3C7;
    border: 1px solid var(--amber);
    border-radius: 6px;
    padding: 7px 12px;
    margin-top: 18px;
    font-size: 9.5px;
    color: #7c5e10;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .sample-banner b { color: #5c4708; }
  .chip {
    background: var(--amber); color: #fff; font-weight: 700;
    font-size: 8px; letter-spacing: 1px; padding: 2px 7px; border-radius: 4px;
    white-space: nowrap;
  }

  /* ── Section headers ───────────────────────── */
  .sec {
    display: flex; align-items: center; gap: 8px;
    margin: 20px 0 9px;
  }
  .sec .bar { width: 4px; height: 15px; background: var(--amber); border-radius: 2px; }
  .sec h2 {
    font-size: 11px; font-weight: 700; color: var(--navy);
    text-transform: uppercase; letter-spacing: .8px;
  }
  .sec .hint { font-size: 9px; color: var(--muted); font-weight: 500; margin-left: auto; }

  /* ── KPI cards ─────────────────────────────── */
  .kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-top: 14px; }
  .kpi {
    background: var(--slate);
    border-radius: 8px;
    padding: 13px 15px;
    border-top: 3px solid var(--amber);
  }
  .kpi .label { font-size: 8.5px; font-weight: 700; color: var(--navy); text-transform: uppercase; letter-spacing: .6px; }
  .kpi .value { font-size: 25px; font-weight: 800; color: var(--navy); margin: 5px 0 2px; letter-spacing: -.5px; }
  .kpi .delta { font-size: 9px; font-weight: 600; }
  .kpi .delta.up { color: var(--green); }
  .kpi .delta.down { color: var(--red); }
  .kpi .delta.flat { color: var(--muted); }

  /* ── Transaction table ─────────────────────── */
  table { width: 100%; border-collapse: collapse; }
  thead th {
    background: var(--navy); color: #fff;
    font-size: 8px; font-weight: 700; text-transform: uppercase; letter-spacing: .5px;
    text-align: left; padding: 7px 9px;
  }
  thead th.r { text-align: right; }
  tbody td { padding: 7px 9px; font-size: 9.5px; vertical-align: top; border-bottom: 1px solid var(--line); }
  tbody tr:nth-child(even) { background: #fafbfc; }
  td.r { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  td.amt-in { color: var(--green); font-weight: 600; }
  td.amt-out { color: var(--ink); }
  .cat {
    display: inline-block; font-size: 8px; font-weight: 700;
    padding: 2px 6px; border-radius: 4px; background: #e8eef4; color: var(--navy);
    white-space: nowrap;
  }
  .note { color: var(--muted); font-size: 8.5px; line-height: 1.35; margin-top: 3px; }
  .note b { color: var(--ink); font-weight: 600; }

  /* ── Two-up cards (summary + miscat) ──────── */
  .twoup { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; align-items: start; }
  .card { border: 1px solid var(--line); border-radius: 8px; padding: 13px 15px; }
  .card p { font-size: 9.5px; line-height: 1.5; color: #374151; }
  .card p + p { margin-top: 7px; }
  .card-title { font-size:9px;font-weight:700;color:var(--navy);text-transform:uppercase;letter-spacing:.6px;margin-bottom:6px; }
  .flag {
    display: flex; gap: 9px; padding: 8px 0; border-bottom: 1px dashed var(--line);
    font-size: 9px; line-height: 1.4;
  }
  .flag:last-child { border-bottom: none; }
  .flag .ico { color: var(--red); font-weight: 800; font-size: 11px; flex-shrink: 0; line-height: 1.2; }
  .flag .fix { color: var(--green); font-weight: 600; }
  .flag .from { color: var(--muted); text-decoration: line-through; }

  /* ── Tier add-on: tax estimate / accounts / rules ── */
  .taxgrid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-top: 4px; }
  .taxbox { background: var(--slate); border-radius: 8px; padding: 11px 13px; border-left: 3px solid var(--navy); }
  .taxbox.total { border-left-color: var(--amber); }
  .taxbox .l { font-size: 8px; font-weight: 700; color: var(--navy); text-transform: uppercase; letter-spacing: .5px; }
  .taxbox .v { font-size: 18px; font-weight: 800; color: var(--navy); margin-top: 4px; letter-spacing: -.3px; }
  .taxnote { font-size: 8.5px; color: var(--muted); line-height: 1.4; margin-top: 9px; }

  .acct-list { width: 100%; border-collapse: collapse; }
  .acct-list td { padding: 6px 9px; font-size: 9px; border-bottom: 1px solid var(--line); }
  .acct-list td.status { text-align: right; color: var(--green); font-weight: 600; }
  .rules li { font-size: 9px; color: #374151; line-height: 1.5; margin-left: 16px; }
  .rules li b { color: var(--navy); }

  /* ── The One Thing ─────────────────────────── */
  .onething {
    background: var(--navy); color: #fff; border-radius: 10px;
    padding: 16px 20px; margin: 22px 0 4px;
    display: flex; gap: 16px; align-items: center;
  }
  .onething .badge {
    background: var(--amber); color: var(--navy); font-weight: 800;
    font-size: 8px; letter-spacing: 1px; padding: 4px 9px; border-radius: 5px;
    text-transform: uppercase; white-space: nowrap; align-self: flex-start;
  }
  .onething h3 { font-size: 13px; font-weight: 700; margin-bottom: 4px; color: #fff; }
  .onething p { font-size: 9.5px; line-height: 1.5; color: #cbd5e1; }
  .onething .dollar { color: var(--amber); font-weight: 800; }

  /* ── Footer ────────────────────────────────── */
  .footer {
    margin-top: 18px;
    border-top: 1px solid var(--line);
    padding: 11px 40px;
    display: flex; justify-content: space-between; align-items: center;
    font-size: 8px; color: var(--muted); letter-spacing: .3px;
  }
  .footer .ef { font-weight: 800; color: var(--navy); }

  @media print {
    html, body { background: #fff; }
    .page { margin: 0; box-shadow: none; width: auto; min-height: auto; }
  }
</style>
</head>
<body>
<div class="page">

  <!-- Header -->
  <div class="header">
    <div>
      <div class="biz">{{ biz_name }}</div>
      <div class="sub">{{ product_name }} · {{ product_tagline }} · {{ month }}{% if location %} · {{ location }}{% endif %}</div>
    </div>
    <div class="brand">
      <div class="pre">POWERED BY</div>
      <div class="mark">EchoFrame</div>
      <div class="tag">Business intelligence, not accounting.</div>
      <div class="tierchip">{{ tier_label }} Plan</div>
    </div>
  </div>

  <div class="body">

    {% if is_sample %}
    <!-- Redacted sample banner -->
    <div class="sample-banner">
      <span class="chip">REDACTED SAMPLE</span>
      <span><b>This is an anonymized demonstration report.</b> Business name, account numbers, and dollar figures are fictional and do not represent a real client. Account details have been masked (••••).</span>
    </div>
    {% endif %}

    <!-- KPI cards -->
    <div class="sec">
      <span class="bar"></span><h2>The Month at a Glance</h2>
      {% if vs_label %}<span class="hint">{{ vs_label }}</span>{% endif %}
    </div>
    <div class="kpis">
      {% for k in kpis %}
      <div class="kpi">
        <div class="label">{{ k.label }}</div>
        <div class="value">{{ k.value }}</div>
        <div class="delta {{ k.delta_class }}">{{ k.delta_text | safe }}</div>
      </div>
      {% endfor %}
    </div>

    <!-- Categorized transactions -->
    <div class="sec">
      <span class="bar"></span><h2>Categorized Transactions</h2>
      <span class="hint">every line explained in plain English</span>
    </div>
    <table>
      <thead>
        <tr>
          <th style="width:62px">Date</th>
          <th>Transaction &amp; what Auto Ledger did with it</th>
          <th style="width:96px">Category</th>
          <th class="r" style="width:80px">Amount</th>
        </tr>
      </thead>
      <tbody>
        {% for t in transactions %}
        <tr>
          <td>{{ t.date }}</td>
          <td>
            {{ t.title }}
            <div class="note"><b>What it was:</b> {{ t.what_was }} <b>Why this category:</b> {{ t.why_category }}</div>
          </td>
          <td><span class="cat">{{ t.category }}</span></td>
          <td class="r {{ t.amt_class }}">{{ t.amount_str }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>

    {% if accounts %}
    <!-- [PRO] Connected accounts -->
    <div class="sec">
      <span class="bar"></span><h2>Connected Accounts</h2>
      <span class="hint">all reconciled within 24 hours</span>
    </div>
    <table class="acct-list">
      <tbody>
        {% for a in accounts %}
        <tr>
          <td><b>{{ a.name }}</b> · {{ a.type }}</td>
          <td>{{ a.txn_count }} transactions</td>
          <td class="status">{{ a.status }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% endif %}

    <!-- What changed + miscategorizations -->
    <div class="sec">
      <span class="bar"></span><h2>What Changed &amp; What We Caught</h2>
    </div>
    <div class="twoup">
      <div class="card">
        <p class="card-title">What changed this month</p>
        {% for p in what_changed %}
        <p>{{ p | safe }}</p>
        {% endfor %}
      </div>
      <div class="card">
        <p class="card-title">Miscategorizations we caught</p>
        {% for m in miscatches %}
        <div class="flag">
          <span class="ico">!</span>
          <span>{{ m | safe }}</span>
        </div>
        {% endfor %}
      </div>
    </div>

    {% if tax_estimate %}
    <!-- [GROWTH] Quarterly tax estimate -->
    <div class="sec">
      <span class="bar"></span><h2>Quarterly Tax Estimate</h2>
      <span class="hint">{{ tax_estimate.period }}</span>
    </div>
    <div class="taxgrid">
      <div class="taxbox"><div class="l">Est. Federal</div><div class="v">{{ tax_estimate.federal }}</div></div>
      <div class="taxbox"><div class="l">Est. State</div><div class="v">{{ tax_estimate.state }}</div></div>
      <div class="taxbox"><div class="l">Self-Employment</div><div class="v">{{ tax_estimate.se }}</div></div>
      <div class="taxbox total"><div class="l">Set Aside</div><div class="v">{{ tax_estimate.total }}</div></div>
    </div>
    <p class="taxnote">{{ tax_estimate.note | safe }}</p>
    {% endif %}

    {% if custom_rules %}
    <!-- [PRO] Custom categorization rules applied -->
    <div class="sec">
      <span class="bar"></span><h2>Custom Rules Applied</h2>
      <span class="hint">your categorization preferences, enforced automatically</span>
    </div>
    <div class="card">
      <ul class="rules">
        {% for r in custom_rules %}
        <li>{{ r | safe }}</li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}

    <!-- The One Thing -->
    <div class="onething">
      <span class="badge">The One Thing</span>
      <div>
        <h3>{{ one_thing.title }}</h3>
        <p>{{ one_thing.body | safe }}</p>
      </div>
    </div>

  </div>

  <!-- Footer -->
  <div class="footer">
    <span><span class="ef">EchoFrame</span> &nbsp;·&nbsp; {{ product_name }}</span>
    <span>{{ tier_label }} Plan · Confidential</span>
  </div>

</div>
</body>
</html>
