<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>EchoFrame — Rival Scan · {{ biz_name }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
<style>
  :root {
    --navy:   #012A4A;
    --navy-2: #013a66;
    --amber:  #C8972A;
    --green:  #059669;
    --red:    #DC2626;
    --ink:    #1f2937;
    --muted:  #6b7280;
    --line:   #e5e7eb;
    --slate:  #f1f5f9;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body {
    background: #525659;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    color: var(--ink);
    -webkit-font-smoothing: antialiased;
  }
  .page {
    width: 8.5in;
    min-height: 11in;
    margin: 24px auto;
    background: #fff;
    box-shadow: 0 6px 30px rgba(0,0,0,.35);
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .body { padding: 22px 40px 0; flex: 1; }

  /* ── Header band ───────────────────────────── */
  .header {
    background: var(--navy);
    color: #fff;
    padding: 20px 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 3px solid var(--amber);
  }
  .header .biz { font-size: 21px; font-weight: 800; letter-spacing: -.2px; }
  .header .sub { font-size: 9.5px; color: #9CA3AF; margin-top: 3px; letter-spacing: .2px; }
  .brand { text-align: right; }
  .brand .pre { font-size: 7px; font-weight: 700; letter-spacing: 1.5px; color: #fff; }
  .brand .mark { font-size: 27px; font-weight: 800; color: var(--amber); line-height: 1; margin: 1px 0; }
  .brand .tag { font-size: 8px; font-style: italic; color: #cbd5e1; }

  /* ── Sample banner ─────────────────────────── */
  .sample-banner {
    margin-top: 16px;
    font-size: 9px; color: var(--muted); line-height: 1.4;
    border-bottom: 1px solid var(--line); padding-bottom: 12px;
  }
  .sample-banner b { color: var(--amber); font-weight: 700; letter-spacing: .5px; }

  /* ── KPI cards ─────────────────────────────── */
  .kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-top: 16px; }
  .kpi {
    background: #eef2f7;
    border-radius: 8px;
    padding: 12px 15px 13px;
  }
  .kpi .label { font-size: 8px; font-weight: 700; color: #9aa6b2; text-transform: uppercase; letter-spacing: .8px; }
  .kpi .value { font-size: 30px; font-weight: 800; color: var(--navy); margin: 4px 0 6px; letter-spacing: -.5px; line-height: 1; }
  .kpi .value.txt { font-size: 22px; }
  .kpi .sub { font-size: 9px; font-weight: 600; color: var(--ink); border-top: 1px solid #dde3ea; padding-top: 7px; }
  .kpi .sub.up   { color: var(--red); }
  .kpi .sub.down { color: var(--green); }
  .kpi .sub.flat { color: var(--muted); }

  /* ── Section header band ───────────────────── */
  .secbar {
    background: var(--navy); color: #fff;
    font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px;
    padding: 7px 12px; border-radius: 4px; margin: 20px 0 0;
    border-left: 4px solid var(--amber);
  }
  .secbar .lt { color: #9CA3AF; font-weight: 600; }

  /* ── Competitor table ──────────────────────── */
  table { width: 100%; border-collapse: collapse; margin-top: 12px; }
  thead th {
    background: var(--navy); color: #fff;
    font-size: 8px; font-weight: 700; text-transform: uppercase; letter-spacing: .4px;
    text-align: left; padding: 8px 9px; vertical-align: bottom;
  }
  thead th.r { text-align: right; }
  tbody td { padding: 8px 9px; font-size: 9.5px; vertical-align: middle; border-bottom: 1px solid var(--line); }
  tbody tr:nth-child(even) { background: #fafbfc; }
  tbody tr.you td { background: #eef2f7; font-weight: 600; }
  tbody tr.you td:first-child { box-shadow: inset 3px 0 0 var(--amber); }
  td.r { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .comp { font-weight: 700; color: var(--navy); }
  .you-tag { color: var(--amber); font-weight: 700; }
  .promo { color: var(--ink); }
  .promo.none { color: var(--muted); font-style: italic; }
  .chg { font-weight: 700; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .chg.alert { color: var(--red); }
  .chg.none  { color: var(--muted); }

  /* ── What moved (dotted bullets) ───────────── */
  .moved { list-style: none; margin: 12px 0 2px; }
  .moved li { position: relative; padding: 0 0 9px 16px; font-size: 9.5px; line-height: 1.45; color: #374151; }
  .moved li b { color: var(--navy); font-weight: 700; }
  .moved .dot { position: absolute; left: 0; top: 4px; width: 7px; height: 7px; border-radius: 50%; }
  .dot.threat      { background: var(--red); }
  .dot.watch       { background: var(--amber); }
  .dot.opportunity { background: var(--green); }
  .dot.neutral     { background: var(--navy); }

  /* ── The One Thing ─────────────────────────── */
  .onething { margin-top: 13px; }
  .onething h3 { font-size: 12.5px; font-weight: 800; color: var(--navy); margin-bottom: 6px; }
  .onething p.body { font-size: 9.5px; line-height: 1.5; color: #374151; }
  .onething ol { margin: 9px 0 9px 18px; }
  .onething ol li { font-size: 9.5px; line-height: 1.5; color: #374151; padding-left: 3px; margin-bottom: 2px; }
  .onething .impact { font-size: 9.5px; font-style: italic; color: var(--green); font-weight: 600; line-height: 1.45; }
  .onething .risk { font-size: 9px; font-style: italic; color: var(--muted); line-height: 1.45; margin-top: 6px; }
  .onething .risk b { color: var(--amber); font-style: normal; font-weight: 700; }

  /* ── Footer ────────────────────────────────── */
  .footer {
    margin-top: 20px;
    border-top: 1px solid var(--line);
    padding: 11px 40px;
    text-align: center;
    font-size: 8px; color: var(--muted); letter-spacing: .3px;
  }
  .footer .ef { font-weight: 800; color: var(--navy); }

  @media print {
    html, body { background: #fff; }
    .page { margin: 0; box-shadow: none; width: auto; min-height: auto; }
  }
</style>
</head>
<body>
<div class="page">

  <!-- Header -->
  <div class="header">
    <div>
      <div class="biz">{{ biz_name }}</div>
      <div class="sub">{{ product_name }} · {{ product_tagline }} · {{ month }}{% if location %} · {{ location }}{% endif %}</div>
    </div>
    <div class="brand">
      <div class="pre">POWERED BY</div>
      <div class="mark">EchoFrame</div>
      <div class="tag">Business intelligence, not accounting.</div>
    </div>
  </div>

  <div class="body">

    {% if is_sample %}
    <div class="sample-banner">
      <b>REDACTED SAMPLE</b> — Fictional business and competitors. Prices, ratings, and promotions are illustrative only and do not reflect any real establishment.
    </div>
    {% endif %}

    <!-- KPI cards -->
    <div class="kpis">
      {% for k in kpis %}
      <div class="kpi">
        <div class="label">{{ k.label }}</div>
        <div class="value{% if k.is_text %} txt{% endif %}">{{ k.value }}</div>
        <div class="sub {{ k.sub_class }}">{{ k.sub | safe }}</div>
      </div>
      {% endfor %}
    </div>

    <!-- Competitor comparison -->
    <div class="secbar">Competitor Comparison <span class="lt">· {{ compare_label }}</span></div>
    <table>
      <thead>
        <tr>
          <th>Competitor</th>
          <th class="r" style="width:78px">Key Price<br>({{ price_unit }})</th>
          <th style="width:96px">Rating / Reviews</th>
          <th style="width:170px">Current Promotion</th>
          <th class="r" style="width:88px">Change vs<br>Last Month</th>
        </tr>
      </thead>
      <tbody>
        {% for c in competitors %}
        <tr{% if c.you %} class="you"{% endif %}>
          <td><span class="comp">{{ c.name }}</span>{% if c.you %} <span class="you-tag">(You)</span>{% endif %}</td>
          <td class="r">{{ c.price }}</td>
          <td>{{ c.rating }}</td>
          <td><span class="promo{% if c.promo_none %} none{% endif %}">{{ c.promo }}</span></td>
          <td class="r"><span class="chg {{ c.chg_class }}">{{ c.change | safe }}</span></td>
        </tr>
        {% endfor %}
      </tbody>
    </table>

    <!-- What moved this week -->
    <div class="secbar">What Moved This Week</div>
    <ul class="moved">
      {% for m in what_moved %}
      <li><span class="dot {{ m.tone }}"></span>{{ m.text | safe }}</li>
      {% endfor %}
    </ul>

    <!-- The One Thing -->
    <div class="secbar">The One Thing To Do This Week</div>
    <div class="onething">
      <h3>{{ one_thing.title }}</h3>
      <p class="body">{{ one_thing.body | safe }}</p>
      <ol>
        {% for s in one_thing.steps %}
        <li>{{ s | safe }}</li>
        {% endfor %}
      </ol>
      <p class="impact">Estimated impact: {{ one_thing.impact | safe }}</p>
      <p class="risk"><b>Risk:</b> {{ one_thing.risk | safe }}</p>
    </div>

  </div>

  <!-- Footer -->
  <div class="footer">
    <span class="ef">EchoFrame</span> &nbsp;|&nbsp; {{ product_name }} &nbsp;·&nbsp; {{ month }} &nbsp;·&nbsp; Confidential
  </div>

</div>
</body>
</html>
