<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>EchoFrame — Quote Revive · {{ biz_name }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
<style>
  :root {
    --navy:#012A4A; --navy-2:#013a66; --amber:#C8972A; --green:#059669;
    --red:#DC2626; --ink:#1f2937; --muted:#6b7280; --line:#e5e7eb; --slate:#f1f5f9;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { background:#525659; font-family:'Inter',-apple-system,BlinkMacSystemFont,sans-serif; color:var(--ink); -webkit-font-smoothing:antialiased; }
  .page { width:8.5in; min-height:11in; margin:24px auto; background:#fff; box-shadow:0 6px 30px rgba(0,0,0,.35); display:flex; flex-direction:column; }
  .body { padding:22px 40px 0; flex:1; }
  .header { background:var(--navy); color:#fff; padding:20px 40px; display:flex; justify-content:space-between; align-items:center; border-bottom:3px solid var(--amber); }
  .header .biz { font-size:21px; font-weight:800; letter-spacing:-.2px; }
  .header .sub { font-size:9.5px; color:#9CA3AF; margin-top:3px; letter-spacing:.2px; }
  .brand { text-align:right; }
  .brand .pre { font-size:7px; font-weight:700; letter-spacing:1.5px; color:#fff; }
  .brand .mark { font-size:27px; font-weight:800; color:var(--amber); line-height:1; margin:1px 0; }
  .brand .tag { font-size:8px; font-style:italic; color:#cbd5e1; }
  .sample-banner { background:#FEF3C7; border:1px solid var(--amber); border-radius:6px; padding:7px 12px; margin-top:18px; font-size:9.5px; color:#7c5e10; display:flex; align-items:center; gap:8px; }
  .sample-banner b { color:#5c4708; }
  .chip { background:var(--amber); color:#fff; font-weight:700; font-size:8px; letter-spacing:1px; padding:2px 7px; border-radius:4px; white-space:nowrap; }
  .sec { display:flex; align-items:center; gap:8px; margin:20px 0 9px; }
  .sec .bar { width:4px; height:15px; background:var(--amber); border-radius:2px; }
  .sec h2 { font-size:11px; font-weight:700; color:var(--navy); text-transform:uppercase; letter-spacing:.8px; }
  .sec .hint { font-size:9px; color:var(--muted); font-weight:500; margin-left:auto; }
  .kpis { display:grid; grid-template-columns:repeat(4,1fr); gap:11px; margin-top:14px; }
  .kpi { background:var(--slate); border-radius:8px; padding:12px 13px; border-top:3px solid var(--amber); }
  .kpi .label { font-size:8px; font-weight:700; color:var(--navy); text-transform:uppercase; letter-spacing:.5px; }
  .kpi .value { font-size:22px; font-weight:800; color:var(--navy); margin:5px 0 2px; letter-spacing:-.5px; }
  .kpi .value small { font-size:11px; font-weight:700; color:var(--muted); letter-spacing:0; }
  .kpi .delta { font-size:8.5px; font-weight:600; line-height:1.35; }
  .kpi .delta.up { color:var(--green); } .kpi .delta.down { color:var(--red); } .kpi .delta.flat { color:var(--muted); }
  .seq { display:grid; grid-template-columns:repeat(3,1fr); gap:12px; margin-top:14px; }
  .step { border:1px solid var(--line); border-radius:8px; overflow:hidden; display:flex; flex-direction:column; }
  .step .cap { background:var(--navy); color:#fff; padding:7px 12px; display:flex; align-items:baseline; justify-content:space-between; }
  .step .cap .day { font-size:10px; font-weight:800; letter-spacing:.3px; }
  .step .cap .chan { font-size:7.5px; font-weight:700; color:var(--amber); text-transform:uppercase; letter-spacing:.8px; }
  .step .msg { padding:10px 12px; font-size:9px; line-height:1.5; color:#374151; flex:1; }
  .step .msg .q { color:var(--navy); font-weight:600; }
  .step .why { padding:7px 12px; background:#fafbfc; border-top:1px solid var(--line); font-size:8px; color:var(--muted); }
  .step .why b { color:var(--ink); font-weight:700; }
  table { width:100%; border-collapse:collapse; }
  thead th { background:var(--navy); color:#fff; font-size:8px; font-weight:700; text-transform:uppercase; letter-spacing:.5px; text-align:left; padding:7px 9px; }
  thead th.r { text-align:right; } thead th.c { text-align:center; }
  tbody td { padding:7px 9px; font-size:9.5px; vertical-align:middle; border-bottom:1px solid var(--line); }
  tbody tr:nth-child(even) { background:#fafbfc; }
  tbody tr.top td { background:#FEF3C7; }
  tbody tr.top td:first-child { box-shadow:inset 3px 0 0 var(--amber); }
  td.r { text-align:right; font-variant-numeric:tabular-nums; white-space:nowrap; }
  td.c { text-align:center; font-variant-numeric:tabular-nums; }
  .quote { font-weight:700; color:var(--navy); }
  .quote small { display:block; font-weight:500; color:var(--muted); font-size:8px; letter-spacing:.2px; margin-top:1px; }
  .pill { display:inline-block; font-size:8.5px; font-weight:700; padding:2px 7px; border-radius:4px; white-space:nowrap; }
  .pill.won { background:#E7F6EF; color:var(--green); } .pill.warm { background:#FEF3C7; color:#7c5e10; }
  .pill.active { background:#E8F0FE; color:var(--navy-2); } .pill.dead { background:#FDECEC; color:var(--red); }
  tfoot td { padding:7px 9px; font-size:9.5px; font-weight:800; color:var(--navy); border-top:2px solid var(--navy); }
  tfoot td.r { text-align:right; font-variant-numeric:tabular-nums; }
  .card { border:1px solid var(--line); border-radius:8px; padding:13px 15px; margin-top:14px; }
  .card .ttl { font-size:9px; font-weight:700; color:var(--navy); text-transform:uppercase; letter-spacing:.6px; margin-bottom:6px; }
  .card p { font-size:9.5px; line-height:1.5; color:#374151; }
  .card .src { font-size:8px; color:var(--muted); margin-top:7px; }
  .card b { color:var(--ink); font-weight:600; }
  .onething { background:var(--navy); color:#fff; border-radius:10px; padding:16px 20px; margin:22px 0 4px; display:flex; gap:16px; align-items:center; }
  .onething .badge { background:var(--amber); color:var(--navy); font-weight:800; font-size:8px; letter-spacing:1px; padding:4px 9px; border-radius:5px; text-transform:uppercase; white-space:nowrap; align-self:flex-start; }
  .onething h3 { font-size:13px; font-weight:700; margin-bottom:4px; color:#fff; }
  .onething p { font-size:9.5px; line-height:1.5; color:#cbd5e1; }
  .onething .dollar { color:var(--amber); font-weight:800; }
  .footer { margin-top:18px; border-top:1px solid var(--line); padding:11px 40px; display:flex; justify-content:space-between; align-items:center; font-size:8px; color:var(--muted); letter-spacing:.3px; }
  .footer .ef { font-weight:800; color:var(--navy); }
  @media print { html,body{background:#fff;} .page{margin:0;box-shadow:none;width:auto;min-height:auto;} }
</style>
</head>
<body>
<div class="page">
  <div class="header">
    <div>
      <div class="biz">{{ biz_name }}</div>
      <div class="sub">{{ product_name }} · {{ product_tagline }} · {{ month }}{% if location %} · {{ location }}{% endif %}</div>
    </div>
    <div class="brand">
      <div class="pre">POWERED BY</div><div class="mark">EchoFrame</div>
      <div class="tag">Business intelligence, not accounting.</div>
    </div>
  </div>
  <div class="body">
    {% if is_sample %}
    <div class="sample-banner">
      <span class="chip">REDACTED SAMPLE</span>
      <span><b>This is an anonymized demonstration report.</b> Business name, customers, and dollar figures are fictional and do not represent a real client.</span>
    </div>
    {% endif %}

    <div class="sec"><span class="bar"></span><h2>Reactivation at a Glance</h2><span class="hint">{{ period_label }}</span></div>
    <div class="kpis">
      {% for k in kpis %}
      <div class="kpi">
        <div class="label">{{ k.label }}</div>
        <div class="value">{{ k.value }}{% if k.unit %}<small> {{ k.unit }}</small>{% endif %}</div>
        <div class="delta {{ k.delta_class }}">{{ k.delta_text | safe }}</div>
      </div>
      {% endfor %}
    </div>

    <div class="sec"><span class="bar"></span><h2>The Follow-Up Sequence</h2><span class="hint">sent automatically when a quote goes quiet</span></div>
    <div class="seq">
      {% for s in steps %}
      <div class="step">
        <div class="cap"><span class="day">{{ s.day }}</span><span class="chan">{{ s.channel }}</span></div>
        <div class="msg">{{ s.message | safe }}</div>
        <div class="why"><b>Goal:</b> {{ s.goal }}</div>
      </div>
      {% endfor %}
    </div>

    <div class="sec"><span class="bar"></span><h2>Aged-Quote Worklist</h2><span class="hint">every cold quote, oldest first</span></div>
    <table>
      <thead><tr>
        <th>Quote</th><th class="r" style="width:78px">Value</th>
        <th class="c" style="width:74px">Days Cold</th><th class="c" style="width:92px">Follow-ups Sent</th>
        <th style="width:96px">Status</th>
      </tr></thead>
      <tbody>
        {% for q in quotes %}
        <tr{% if q.top %} class="top"{% endif %}>
          <td><span class="quote">{{ q.title }}{% if q.detail %}<small>{{ q.detail }}</small>{% endif %}</span></td>
          <td class="r">{{ q.value }}</td>
          <td class="c">{{ q.days }}</td>
          <td class="c">{{ q.followups }}</td>
          <td><span class="pill {{ q.pill_class }}">{{ q.status_label }}</span></td>
        </tr>
        {% endfor %}
      </tbody>
      <tfoot><tr>
        <td>{{ worklist_footnote }}</td>
        <td class="r">{{ won_value }}</td>
        <td class="c" colspan="2">won this cycle</td>
        <td><span class="pill won">{{ recovered_pct }} recovered</span></td>
      </tr></tfoot>
    </table>

    <div class="card">
      <div class="ttl">How Quote Revive Works</div>
      <p>{{ method_note | safe }}</p>
      <p class="src">{{ source_line }}</p>
    </div>

    <div class="onething">
      <span class="badge">The One Thing</span>
      <div><h3>{{ one_thing.title }}</h3><p>{{ one_thing.body | safe }}</p></div>
    </div>
  </div>
  <div class="footer">
    <span><span class="ef">EchoFrame</span> &nbsp;·&nbsp; {{ product_name }}</span>
    <span>Page 1 of 1 · Confidential</span>
  </div>
</div>
</body>
</html>
