{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "runtime": "@vercel/python@4.3.1",
      "maxDuration": 300,
      "memory": 1024,
      "includeFiles": "{main.py,registry.py,sign.py,store.py,emails.py,reminders.py,intake_specs.py,engine.py,products/**,templates/**}"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "crons": [
    { "path": "/api/cron/reminders", "schedule": "0 14 * * *" }
  ]
}
