// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified DateTime? // required by the NextAuth Prisma adapter
  image         String?   // required by the NextAuth Prisma adapter

  // --- Rate Watch fields (kept so the unified client serves both tools) ---
  slug               String?  @unique // optional so NextAuth can create users without one
  industry           String?  // doubles as Rate Watch industry_type
  companySizeBracket String   @default("SMALL") // "SMALL" (1-10), "MEDIUM" (11-50), "LARGE" (50+)
  location           String   @default("Columbus, GA")
  contactName        String?

  // Rate Watch subscription (Core $99 / Pro $199, 14-day trial).
  rateWatchTier         String    @default("CORE") // CORE, PRO
  rateWatchTrialEndDate DateTime? // null once converted to a paid plan

  // --- Auto Ledger fields (automated bookkeeping tenant + billing) ---
  subscriptionTier   String  @default("STARTER") // STARTER ($79), GROWTH ($149), PRO ($299)
  subscriptionStatus String  @default("ACTIVE")  // ACTIVE, PAST_DUE, CANCELED, TRIALING

  // --- Shift Lens fields (shift P&L; waitlist pricing + integrations) ---
  waitlistStatus      String  @default("PENDING") // PENDING, EARLY_BIRD_LOCKED
  posIntegration      String? // e.g., "Square", "Toast"
  scheduleIntegration String? // e.g., "7shifts", "Homebase"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contracts               VendorContract[]
  competitors             Competitor[]
  quotes                  Quote[]
  accounts                Account[]
  sessions                Session[]
  connectedAccounts       ConnectedAccount[]
  monthlyReports          MonthlyReport[]
  shifts                  Shift[]
  scheduleRecommendations ScheduleRecommendation[]

  @@map("users")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Competitor {
  id                String     @id @default(cuid())
  userId            String
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  name              String
  website           String
  googleBusinessUrl String?
  yelpUrl           String?
  status            String     @default("ACTIVE") // ACTIVE, INACTIVE

  snapshots         CompetitorSnapshot[]
  alerts            Alert[]

  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@map("competitors")
}

model CompetitorSnapshot {
  id                String     @id @default(cuid())
  competitorId      String
  competitor        Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  priceRange        String?    // e.g., "$15-$50"
  reviewCount       Int?
  averageRating     Float?
  activePromos      String?    @db.Text
  scrapedData       String?    @db.Text // JSON string of raw scraped data

  scrapedAt         DateTime   @default(now())
  createdAt         DateTime   @default(now())

  @@index([competitorId])
  @@index([scrapedAt])
  @@map("competitor_snapshots")
}

model Alert {
  id                String     @id @default(cuid())
  competitorId      String
  competitor        Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  alertType         String     // PRICE_CHANGE, REVIEW_UPDATE, PROMO_NEW, RATING_CHANGE
  oldValue          String?
  newValue          String?
  severity          String     @default("MEDIUM") // LOW, MEDIUM, HIGH
  description       String?    @db.Text

  sentAt            DateTime?
  createdAt         DateTime   @default(now())

  @@index([competitorId])
  @@index([createdAt])
  @@map("alerts")
}

model VendorContract {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  vendorName    String
  category      String     // e.g., "Janitorial", "Insurance", "Software", "HVAC"
  currentRate   Float
  frequency     String     // "MONTHLY" or "ANNUAL"
  renewalDate   DateTime

  notes         String?

  negotiationDrafts NegotiationDraft[]

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@map("vendor_contracts")
}

model MarketBenchmark {
  id                    String     @id @default(cuid())
  category              String
  companySizeBracket    String     // "SMALL" (1-10), "MEDIUM" (11-50), "LARGE" (50+)
  location              String     // Default: "Columbus, GA"
  localAvgRateMonthly   Float
  localAvgRateAnnual    Float?

  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@unique([category, companySizeBracket, location])
  @@map("market_benchmarks")
}

// ============================================================================
// Quote Revive — automated quote follow-up for service businesses
// ============================================================================

model Quote {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  customerName    String
  customerEmail   String
  jobDescription  String   @db.Text
  quoteAmount     Float
  // PENDING, FOLLOW_UP_ACTIVE, COLD, WON, LOST
  status          String   @default("PENDING")

  dateSent        DateTime
  lastContactDate DateTime
  // True when the quote was closed/won after entering the revive sequence.
  wonViaRevive    Boolean  @default(false)

  sequence        FollowUpSequence[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@map("quotes")
}

model FollowUpSequence {
  id                String   @id @default(cuid())
  quoteId           String
  quote             Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  // 1, 2, or 3
  sequenceStep      Int
  // Day offset from date_sent this step targets (3, 7, 14).
  dayOffset         Int
  messageTemplate   String   @db.Text
  scheduledSendDate DateTime
  // PENDING, SENT, PAUSED
  status            String   @default("PENDING")

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([quoteId])
  @@index([scheduledSendDate])
  @@map("follow_up_sequences")
}

// ============================================================================
// Auto Ledger — automated, plain-English bookkeeping for small businesses
// ============================================================================

model ConnectedAccount {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  institutionName String   // e.g., "Chase", "American Express"
  accountType     String   // "CHECKING", "CREDIT_CARD"
  mask            String?  // last 4 digits, e.g., "4021"
  lastSyncDate    DateTime?
  // HEALTHY (within 24h), SYNCING, ERROR (needs re-auth)
  syncStatus      String   @default("HEALTHY")

  transactions    Transaction[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@map("connected_accounts")
}

model Transaction {
  id               String           @id @default(cuid())
  accountId        String
  account          ConnectedAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  date             DateTime
  // Negative = money out, positive = money in.
  amount           Float
  rawDescription   String           // e.g., "AMZN MKTPLACE PMT"
  aiCategory       String?          // e.g., "Office Supplies"
  // The hero feature: human-readable story for the transaction.
  plainEnglishNote String?          @db.Text
  // RECONCILED, FLAGGED (flagged for human review)
  status           String           @default("RECONCILED")

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([accountId])
  @@index([status])
  @@index([date])
  @@map("transactions")
}

model MonthlyReport {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  month             Int      // 1-12
  year              Int
  summaryText       String   @db.Text // plain-English narrative
  actionItem        String   @db.Text // the "One Thing" to do this month
  // Quarterly tax estimate — only populated for GROWTH / PRO tiers.
  taxEstimateAmount Float?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, year, month])
  @@index([userId])
  @@map("monthly_reports")
}

// ============================================================================
// Rate Watch — vendor benchmarking & renegotiation
// NOTE: the spec's "Vendor" and "BenchmarkData" tables are already served by
// the existing `VendorContract` and `MarketBenchmark` models above (same
// shape), so they are reused rather than duplicated. Subscription tier + trial
// live on `User` (rateWatchTier / rateWatchTrialEndDate). The only net-new
// model is the saved negotiation draft below.
// ============================================================================

model NegotiationDraft {
  id          String         @id @default(cuid())
  contractId  String
  contract    VendorContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  subjectLine String
  bodyText    String         @db.Text
  // DRAFT, SENT
  status      String         @default("DRAFT")
  sentAt      DateTime?

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([contractId])
  @@map("negotiation_drafts")
}

// ============================================================================
// Shift Lens — shift-by-shift P&L and labor tracking
// ============================================================================

model Shift {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  date            DateTime
  shiftName       String   // e.g., "Tuesday Evening"
  startTime       String   // display string, e.g., "5:00 PM"
  endTime         String   // display string, e.g., "11:00 PM"

  totalRevenue    Float
  actualLaborCost Float
  netMargin       Float    // totalRevenue − actualLaborCost
  laborPercentage Float    // actualLaborCost / totalRevenue * 100
  // PROFITABLE (<25%), BORDERLINE (25-35%), BLEEDING (>35%)
  status          String

  alerts          ShiftAlert[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([date])
  @@map("shifts")
}

model ShiftAlert {
  id         String   @id @default(cuid())
  shiftId    String
  shift      Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  type       String   // e.g., "Labor Threshold Exceeded"
  message    String   @db.Text // plain-English explanation
  isResolved Boolean  @default(false)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([shiftId])
  @@map("shift_alerts")
}

model ScheduleRecommendation {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  weekStartDate      DateTime
  recommendationText String   @db.Text
  // PENDING, APPROVED, DISMISSED
  status             String   @default("PENDING")

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId])
  @@map("schedule_recommendations")
}
