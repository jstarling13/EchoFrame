require('dotenv').config();
const express = require('express');
const cors = require('cors');
const stripe = require('stripe')(process.env.STRIPE_SECRET_KEY);

const app = express();

app.use(cors({ origin: process.env.CLIENT_URL }));
app.use(express.json());

// Product map — replace dummy Price IDs with real ones from your Stripe Dashboard
// Monthly Clarity Report uses 'subscription' mode (recurring); the other two are one-time 'payment'
const ECHOFRAME_PRODUCTS = {
  'monthly-clarity-report': { priceId: 'price_150_dummy',  mode: 'subscription' },
  'business-audit':         { priceId: 'price_499_dummy',  mode: 'payment'      },
  'competitor-report':      { priceId: 'price_299_dummy',  mode: 'payment'      }
};

app.post('/create-checkout-session', async (req, res) => {
  try {
    const { productId } = req.body;
    const product = ECHOFRAME_PRODUCTS[productId];

    if (!product) {
      return res.status(400).json({ error: 'Invalid product selected.' });
    }

    const session = await stripe.checkout.sessions.create({
      line_items: [{ price: product.priceId, quantity: 1 }],
      mode: product.mode,
      success_url: `${process.env.CLIENT_URL}/success?session_id={CHECKOUT_SESSION_ID}`,
      cancel_url:  `${process.env.CLIENT_URL}/cancel`,
    });

    res.json({ url: session.url });

  } catch (error) {
    console.error('Stripe error:', error.message);
    res.status(500).json({ error: 'Internal Server Error' });
  }
});

const PORT = process.env.PORT || 4242;
app.listen(PORT, () => console.log(`EchoFrame revenue engine running on http://localhost:${PORT}`));